APP_NAME=AI Image Studio
APP_ENV=production
APP_VERSION=0.1.0
APP_IMAGE_REFERENCE=ai-image-studio:local
LISTEN_ADDR=0.0.0.0:3000
STATIC_DIR=/app/static

# 首次启动且数据库不存在管理员时执行 Bootstrap；默认密码登录后必须修改。
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_ADMIN_FORCE_PASSWORD_CHANGE=true

# Docker Compose 可直接启动的公开默认值；对外提供服务前请在 .env 中覆盖。
SESSION_SECRET=cdb19bd3f1f73878156c78857294cbc6d6eb8ab9e8b7fb09462a62859a936169
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=true
CREDENTIAL_MASTER_KEY=ad0XQKe7dDLx+hgksLlK9NCGYASkPUDq4VUV7TZcfEU=

DATABASE_URL=postgres://ai_image_studio:18843de4f2e37455bedfe7e9fad84ab8f70e456c053f266a@db:5432/ai_image_studio
DATABASE_MAX_CONNECTIONS=10
POSTGRES_DB=ai_image_studio
POSTGRES_USER=ai_image_studio
POSTGRES_PASSWORD=18843de4f2e37455bedfe7e9fad84ab8f70e456c053f266a

# 新图片默认写入 local 或 s3；历史图片仍按每条记录的 storage_driver 读取。
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/data/images

STORAGE_S3_ENABLED=false
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_PREFIX=ai-image-studio/
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# 周期扫描数据库与 Local/S3 实际对象；只自动删除超过宽限期且符合平台 Key 格式的孤儿文件。
STORAGE_CONSISTENCY_SCAN_ENABLED=true
STORAGE_CONSISTENCY_SCAN_INTERVAL_SECONDS=86400
STORAGE_ORPHAN_GRACE_SECONDS=86400

# 可选：内部 Provider、Release Manifest 或 Host Updater HTTPS 服务使用私有 CA 时，挂载并填写绝对 PEM 路径。
HTTP_CA_CERT_FILE=
REQUEST_TIMEOUT_SECONDS=600
CONNECT_TIMEOUT_SECONDS=15
MAX_UPLOAD_SIZE_MB=25
MAX_PROVIDER_IMAGE_SIZE_MB=50
TASK_STREAM_HEARTBEAT_SECONDS=15
# inline：API 进程内执行；redis：由独立 Worker 执行。
TASK_EXECUTION_MODE=redis
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_KEY=ai-image-studio:tasks
TASK_MAX_RETRIES=2
TASK_RETRY_DELAY_SECONDS=3

# 首版使用进程内固定窗口；多实例共享限流在 V0.4 使用 Redis 实现。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IP_REQUESTS=240
RATE_LIMIT_SESSION_REQUESTS=180
RATE_LIMIT_USER_REQUESTS=120

# Web 应用只委托独立 Host Updater，不直接操作 Docker。
UPDATE_CHANNEL=stable
UPDATE_MANIFEST_URL=
HOST_UPDATER_URL=
HOST_UPDATER_SOCKET=
HOST_UPDATER_TOKEN=
HOST_UPDATER_SOCKET_DIR=./data/updater
KEEP_PREVIOUS_RELEASES=3
ALLOW_CUSTOM_BASE_URL=false
ALLOWED_PROVIDER_HOSTS=api.openai.com,generativelanguage.googleapis.com,api.x.ai

RUST_LOG=ai_image_studio=info,tower_http=info
