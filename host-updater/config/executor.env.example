# 该文件由 root 管理，权限建议为 0600。不得写入 Web 容器。
APP_DIR=/opt/ai-image-studio
COMPOSE_FILE=/opt/ai-image-studio/docker-compose.yml
BASE_ENV_FILE=/opt/ai-image-studio/.env.example
APP_ENV_FILE=/opt/ai-image-studio/.env
RELEASE_ENV_FILE=/var/lib/ai-image-studio-updater/release.env

STATE_ROOT=/var/lib/ai-image-studio-updater
BACKUP_ROOT=/var/lib/ai-image-studio-updater/backups
LOCAL_STORAGE_PATH=/opt/ai-image-studio/data/images
STORAGE_DRIVER=local

# S3 模式必须由独立备份任务持续写入最近一次不可变备份/版本快照引用。
S3_BACKUP_REFERENCE_FILE=/var/lib/ai-image-studio-updater/s3-backup-reference.txt
S3_BACKUP_MAX_AGE_SECONDS=86400

UPDATE_MANIFEST_URL=https://github.com/KodeChicken/ai-image-studio/releases/latest/download/release-manifest.json

# 首次接管现有部署时使用；正式环境必须是已验证的仓库、版本和 Digest。
INITIAL_APP_IMAGE=ghcr.io/kodechicken/ai-image-studio:0.1.0
INITIAL_APP_VERSION=0.1.0
INITIAL_APP_DIGEST=sha256:replace_with_64_hex_characters
INITIAL_SCHEMA_MIN_SUPPORTED=1
INITIAL_SCHEMA_MAX_SUPPORTED=9

POSTGRES_USER=ai_image_studio
POSTGRES_DB=ai_image_studio
PUBLIC_HEALTH_URL=http://127.0.0.1:3100/api/v1/ready
CANDIDATE_PORT=3198
KEEP_PREVIOUS_RELEASES=3
MIN_FREE_BYTES=5368709120
