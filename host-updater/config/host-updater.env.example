HOST_UPDATER_LISTEN_ADDR=127.0.0.1:3199
HOST_UPDATER_UNIX_SOCKET=/run/ai-image-studio-updater/host-updater.sock
# Web 容器运行用户的 GID；Dockerfile 默认 USER 10001:10001。
HOST_UPDATER_SOCKET_GID=10001
HOST_UPDATER_TOKEN=replace-with-at-least-32-random-bytes
HOST_UPDATER_STATE_DIR=/var/lib/ai-image-studio-updater/service
HOST_UPDATER_EXECUTOR_PATH=/usr/local/libexec/ai-image-studio/execute-update.sh
HOST_UPDATER_EXECUTOR_CONFIG=/etc/ai-image-studio-updater/executor.env
# 安装脚本后执行 sha256sum，并把结果填到这里以固定执行器内容。
HOST_UPDATER_EXECUTOR_SHA256=
HOST_UPDATER_JOB_TIMEOUT_SECONDS=1800
RUST_LOG=ai_image_studio_host_updater=info,tower_http=info
