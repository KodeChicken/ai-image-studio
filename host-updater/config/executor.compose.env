APP_DIR=/workspace
COMPOSE_FILE=/workspace/docker-compose.yml
BASE_ENV_FILE=/workspace/.env.example
APP_ENV_FILE=/workspace/.env
RELEASE_ENV_FILE=/deployment-data/updater/release.env

COMPOSE_PROJECT_NAME=ai-image-studio
ACTIVE_APP_IMAGE=ai-image-studio:active
USE_ACTIVE_IMAGE_ALIAS=true
STATE_ROOT=/deployment-data/updater
BACKUP_ROOT=/deployment-data/updater/backups
LOCAL_STORAGE_PATH=/deployment-data/images
LOCAL_STORAGE_DOCKER_PATH=auto
STORAGE_DRIVER=${STORAGE_DRIVER:-local}
CANDIDATE_USE_NETWORK_DNS=true

# S3 模式必须由独立备份任务持续写入最近一次不可变备份/版本快照引用。
S3_BACKUP_REFERENCE_FILE=/deployment-data/updater/s3-backup-reference.txt
S3_BACKUP_MAX_AGE_SECONDS=86400

UPDATE_MANIFEST_URL=${UPDATE_MANIFEST_URL:-https://github.com/KodeChicken/ai-image-studio/releases/latest/download/release-manifest.json}

# Compose 首次接管时从活动镜像读取本地 Image ID，无需人工填写 Digest。
INITIAL_APP_IMAGE=ai-image-studio:active
INITIAL_APP_VERSION=auto
INITIAL_APP_DIGEST=auto
INITIAL_SCHEMA_MIN_SUPPORTED=1
INITIAL_SCHEMA_MAX_SUPPORTED=12

POSTGRES_USER=${POSTGRES_USER:-ai_image_studio}
POSTGRES_DB=${POSTGRES_DB:-ai_image_studio}
PUBLIC_HEALTH_URL=http://app:3000/api/v1/ready
CANDIDATE_PORT=3198
KEEP_PREVIOUS_RELEASES=${KEEP_PREVIOUS_RELEASES:-3}
MIN_FREE_BYTES=${UPDATER_MIN_FREE_BYTES:-5368709120}
